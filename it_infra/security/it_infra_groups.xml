<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.module.category" id="module_category_it_infra">
        <field name="name">IT Infra</field>
        <field name="description">IT Infrastructure</field>
        <field name="sequence">1</field>
    </record>

    <record id="res_groups_privilege_it_infra" model="res.groups.privilege">
        <field name="name">IT Infra</field>
        <field name="category_id" ref="module_category_it_infra" />
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_it_infra" />
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(4,ref('group_user'))]" />
        <field name="privilege_id" ref="res_groups_privilege_it_infra" />
    </record>
</odoo>
